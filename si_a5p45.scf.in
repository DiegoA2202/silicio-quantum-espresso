&CONTROL
    calculation = 'scf',
    restart_mode = 'from_scratch',
    prefix = 'si_a5p45',
    pseudo_dir = './pseudo/',
    outdir = './equilibrio_si_rZlTcl/tmp_a5p45/',
/

&SYSTEM
    ibrav = 0,
    nat = 2,
    ntyp = 1,
    ecutwfc = 80,
    ecutrho = 800,
    occupations = 'fixed',
/

&ELECTRONS
    conv_thr = 1.0d-10,
    mixing_beta = 0.7,
/

ATOMIC_SPECIES
Si 28.085 Si_PBE_USPP.UPF

ATOMIC_POSITIONS crystal
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25

K_POINTS automatic
10 10 10 0 0 0

CELL_PARAMETERS angstrom
0.00000000 2.72500000 2.72500000
2.72500000 0.00000000 2.72500000
2.72500000 2.72500000 0.00000000
